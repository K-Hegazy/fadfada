# ==========================================
# FADFADA (فضفضه) — ENVIRONMENT CONFIGURATION
# ==========================================

# GEMINI_API_KEY: Required for Fadfada AI Guide and smart moderation.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of your deployed application (e.g. https://fadfada.app or Cloud Run URL)
APP_URL="MY_APP_URL"

# ==========================================
# PERSISTENT CLOUD STORAGE (CLOUD RUN READY)
# ==========================================

# OPTION 1: Google Cloud Storage (Native for Google Cloud Run)
# If deployed on Cloud Run, the Service Account can authenticate automatically.
# Bucket stores persistent uploads (/uploads/*) and database checkpoints.
GCS_BUCKET="fadfada-storage-bucket"
# Optional service account key (JSON in base64 format, or path to key file):
# GCS_KEY_BASE64="ey..."
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/gcs-key.json"

# OPTION 2: Supabase Storage & Database (Alternative Cloud Provider)
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
# SUPABASE_STORAGE_BUCKET="fadfada-uploads"

# OPTION 3: External PostgreSQL / Cloud SQL Database (Optional)
# DATABASE_URL="postgresql://user:password@host:5432/fadfada"

# OPTION 4: Cloud Run Volume Mount Path (Optional)
# If using Cloud Run Volume Mount to attach a Cloud Storage bucket directly to the container:
# UPLOAD_DIR="/data/uploads"

# ==========================================
# SMTP EMAIL CONFIGURATION (فضفضه)
# ==========================================
# Used for real email verification and password resets.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="fadfada.app@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="فضفضه <fadfada.app@gmail.com>"
